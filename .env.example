# ---- Database ----
# Remote Turso database (turso://, libsql:// or https://) plus its auth token.
TURSO_DATABASE_URL=turso://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<your_turso_auth_token>
# For local development, a SQLite file works with no token:
# TURSO_DATABASE_URL=file:./dev.db

# Apply embedded migrations at startup (default true). With several instances,
# set false and run `webhook-delivery-service migrate` as a one-off job instead.
MIGRATE_ON_START=true

# ---- Server ----
PORT=8080
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted (default: none).
TRUSTED_PROXIES=
# Graceful shutdown budget; Cloud Run allows 10s after SIGTERM.
SHUTDOWN_TIMEOUT=9s
LOG_LEVEL=INFO

# ---- Redis cache (optional) ----
REDIS_URL=
# Used by docker-compose for the bundled Redis.
REDIS_PASSWORD=change-me

# ---- Admin authentication ----
ADMIN_AUTH_ENABLED=true
ADMIN_USERNAME=<your_admin_username>
ADMIN_PASSWORD=<your_admin_password>

# ---- Ingest limits ----
INGEST_MAX_BODY_SIZE=1048576
INGEST_SIZE_LIMIT_ENABLED=true
INGEST_RATE_LIMIT_RPS=10
INGEST_RATE_LIMIT_BURST=20
INGEST_RATE_LIMIT_ENABLED=true

# ---- Outbound delivery ----
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_DIAL_TIMEOUT_SECONDS=10
WEBHOOK_TLS_TIMEOUT_SECONDS=10
WEBHOOK_MAX_REDIRECTS=0
WEBHOOK_ALLOW_PRIVATE_IPS=false

# ---- Worker ----
# WORKER_ID=worker-1
