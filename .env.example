TURSO_AUTH_TOKEN = <your_turso_auth_token>
TURSO_DATABASE_URL = <your_turso_database_url>
REDIS_URL = <your_redis_url>

# Admin Authentication (optional - disabled by default)
# Set ADMIN_AUTH_ENABLED=true to require Basic Auth for admin UI and APIs
# WARNING: Leaving auth disabled is unsafe for untrusted deployments
ADMIN_AUTH_ENABLED = false
ADMIN_USERNAME = <your_admin_username>
ADMIN_PASSWORD = <your_admin_password>

# Ingest Request Size Limiting (optional)
# Default: 1048576 bytes (1MB), enabled by default
INGEST_MAX_BODY_SIZE = 1048576
INGEST_SIZE_LIMIT_ENABLED = true

# Ingest Rate Limiting (optional)
# Default: 10 requests/sec per subscription, burst of 20, enabled by default
INGEST_RATE_LIMIT_RPS = 10
INGEST_RATE_LIMIT_BURST = 20
INGEST_RATE_LIMIT_ENABLED = true

# Outbound Webhook Delivery Configuration (optional)
# Configures HTTP client timeouts and SSRF protection for webhook delivery
# Defaults: 30s total timeout, 10s dial/TLS timeout, no redirects, SSRF protection enabled
WEBHOOK_TIMEOUT_SECONDS = 30
WEBHOOK_DIAL_TIMEOUT_SECONDS = 10
WEBHOOK_TLS_TIMEOUT_SECONDS = 10
WEBHOOK_MAX_REDIRECTS = 0
WEBHOOK_ALLOW_PRIVATE_IPS = false

# Worker Configuration (optional)
# WORKER_ID: Unique identifier for this worker instance (auto-generated if not set)
# WORKER_ID = worker-1