# ---- Database ----
# Remote Turso database (turso://, libsql:// or https://) plus its auth token.
TURSO_DATABASE_URL=turso://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<your_turso_auth_token>
# For local development, a SQLite file works with no token:
# TURSO_DATABASE_URL=file:./dev.db

# Apply embedded migrations at startup (default true). With several instances,
# set false and run `webhook-delivery-service migrate` as a one-off job instead.
MIGRATE_ON_START=true

# ---- Server ----
PORT=8080
# Gin runs in release mode unless GIN_MODE is set (debug|test).
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted (default: none).
TRUSTED_PROXIES=
# Graceful shutdown budget; Cloud Run allows 10s after SIGTERM.
SHUTDOWN_TIMEOUT=9s
LOG_LEVEL=INFO

# ---- Redis cache (optional) ----
REDIS_URL=
# Used by docker-compose for the bundled Redis.
REDIS_PASSWORD=change-me

# ---- Admin authentication (fails closed) ----
# REQUIRED: the server refuses to start unless both are set. Set them on Cloud Run
# (or any host) BEFORE deploying this version, or the new revision crashes on boot.
ADMIN_USERNAME=<your_admin_username>
ADMIN_PASSWORD=<your_admin_password>
# Local development only: turns admin auth off (logs a loud warning).
# ADMIN_AUTH_DISABLED=true
# Extra origins allowed to make state-changing admin requests (CSRF), comma-separated.
# CSRF_TRUSTED_ORIGINS=https://admin.example.com

# ---- Ingest limits ----
INGEST_MAX_BODY_SIZE=1048576
INGEST_SIZE_LIMIT_ENABLED=true
INGEST_RATE_LIMIT_RPS=10
INGEST_RATE_LIMIT_BURST=20
INGEST_RATE_LIMIT_ENABLED=true

# ---- Outbound delivery ----
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_DIAL_TIMEOUT_SECONDS=10
WEBHOOK_TLS_TIMEOUT_SECONDS=10
WEBHOOK_MAX_REDIRECTS=0
WEBHOOK_ALLOW_PRIVATE_IPS=false

# ---- Delivery worker ----
# WORKER_ID=worker-1          # defaults to a random id per process
WORKER_CONCURRENCY=10         # parallel deliveries per instance
WORKER_IDLE_MAX=2s            # longest poll back-off when the queue is empty
WORKER_MAX_ATTEMPTS=6         # 1 try + 5 retries (10s, 30s, 1m, 5m, 15m), then dead letter

# ---- Retention (cleanup runs at startup, then hourly) ----
LOG_RETENTION_HOURS=72
TASK_RETENTION_DAYS=7
DLQ_RETRIED_RETENTION_DAYS=30
